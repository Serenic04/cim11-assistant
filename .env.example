# Copier en .env et remplir — ne jamais committer le .env reel.

# data_api
DATABASE_URL=postgresql://user:password@localhost:5432/cim11
DATA_API_KEY=change-me

# model_api
MODEL_API_KEY=change-me
HF_TOKEN=hf_xxx                       # acces au modele gate meta-llama/Meta-Llama-3-8B-Instruct
BASE_MODEL=meta-llama/Meta-Llama-3-8B-Instruct
ADAPTER_PATH=../Fine-Tuning/llama3_codage_cim11

# app_streamlit — gestion des droits d'acces (C17)
# Format : identifiant:motdepasse:role  (roles : agent | responsable), separes par des virgules.
# Le profil "agent" accede a l'assistant de codage ; "responsable" accede en plus
# a la page Monitoring. Sans cette variable, des comptes de demonstration sont utilises.
APP_UTILISATEURS=agent1:change-me:agent,resp1:change-me:responsable
